<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Huge Battery Percentage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvChargeLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="sans-serif-thin"
            android:textSize="120sp"
            android:gravity="center" />
            
        <TextView
            android:id="@+id/tvChargeState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="?android:attr/textColorSecondary"
            android:fontFamily="sans-serif"
            android:textSize="18sp"
            android:gravity="center" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />

    <!-- Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_label_temperature"
                        android:textColor="?android:attr/textColorSecondary"
                        android:fontFamily="sans-serif-light"
                        android:textSize="14sp"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="?android:attr/textColorPrimary"
                        android:fontFamily="sans-serif"
                        android:textSize="20sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#222222" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_label_ac_power"
                        android:textColor="?android:attr/textColorSecondary"
                        android:fontFamily="sans-serif-light"
                        android:textSize="14sp"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/tvAcPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="?android:attr/textColorPrimary"
                        android:fontFamily="sans-serif"
                        android:textSize="20sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="2dp" android:background="@android:color/holo_blue_light" />

    <!-- Console -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#000000">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:fontFamily="monospace"
            android:textColor="#00FF00"
            android:padding="16dp" />

    </ScrollView>

</LinearLayout>
