<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Status Block -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_title_active"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_info_server"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Control Element -->
    <ToggleButton
        android:id="@+id/btnToggleServer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textOn="@string/btn_on"
        android:textOff="@string/btn_off"
        android:layout_marginBottom="32dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@android:color/holo_blue_light"
        android:layout_marginBottom="16dp" />

    <!-- Data and Logs Block -->
    <TextView
        android:id="@+id/tvTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Заряд: 85% (Розряджається)\nТемпература: 32.0°C\nСтан: Живлення від мережі: ВІДКЛЮЧЕНО"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Останнє підключення: 22:00:05 (через 127.0.0.1)"
        android:textAppearance="?android:attr/textAppearanceSmall" />

</LinearLayout>
